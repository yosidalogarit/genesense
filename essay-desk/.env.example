# Copy this file to .env and fill in what you have. Every key is optional;
# the app tells you what is switched off.

# --- AI: smarter search queries + "notable phrases" lists -------------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Or use Claude instead (paid): https://console.anthropic.com/
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# LLM_PROVIDER=gemini   # pick one when both keys are set

# --- Editorial / journalism search (set at least one) ----------------------
# Tavily, built for this kind of search, free monthly credits: https://tavily.com
TAVILY_API_KEY=
# The Guardian Open Platform, free developer key, gives full article text: https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=
# Brave Search API: https://brave.com/search/api/
BRAVE_API_KEY=

# --- Academic search (works without keys) ----------------------------------
# OpenAlex shares a small daily budget per network without a key. A free key avoids that:
# https://openalex.org/  (Crossref is used automatically when OpenAlex is unavailable)
OPENALEX_API_KEY=
# Optional: sent to OpenAlex/Crossref as a courtesy contact address
CONTACT_EMAIL=

# --- Server -----------------------------------------------------------------
# PORT=5178
# HOST=127.0.0.1   # use 0.0.0.0 to open it from a phone on the same Wi-Fi
