{
  "name": "essay-desk",
  "version": "0.1.0",
  "private": true,
  "description": "Paste an essay prompt, find academic and editorial sources, read, highlight, note, and pull verbatim phrases.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.4.18",
    "express": "^5.3.0",
    "jsdom": "^31.0.1",
    "unpdf": "^1.9.1"
  }
}
